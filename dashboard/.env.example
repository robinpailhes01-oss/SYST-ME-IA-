# Copy to .env.local for local dev. On Vercel, set these in the Environment Variables UI.

# Project URL (the same one used by n8n)
NEXT_PUBLIC_SUPABASE_URL=https://jlcqxtxpvuyfznecpwqu.supabase.co

# Publishable / anon key (safe to ship to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_7SK1n58qlftfoa93TragOA_FOic00Ra

# Secret key (server-only, NEVER expose to the browser)
# Same value as the "Supabase REST" credential in n8n.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — restrict auth to one email (for the dashboard login)
ALLOWED_EMAIL=contact@robinpailhes.fr

# Resend — for the "Envoyer via Resend" button on approved emails
# Get your key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Optional override of the From address. Defaults to Resend's sandbox.
RESEND_FROM=Robin <onboarding@resend.dev>
# Sandbox safety: if set, ALL outgoing mails go here instead of the lead's
# contact_email. Keep set during dev so you don't accidentally email prospects.
RESEND_REDIRECT_TO=contact@robinpailhes.fr

# Public origin of the dashboard. Used to build tracking pixel URLs inside
# outgoing emails. Falls back to the request host if unset, which works on
# Vercel but breaks if the email is forwarded from a preview deployment.
# Set this to the prod URL once the domain is final.
NEXT_PUBLIC_DASHBOARD_URL=https://syst-me-ia.vercel.app
